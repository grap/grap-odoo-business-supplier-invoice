<odoo>

    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[
            (4, ref('uom.group_uom')),
        ]" />
    </record>

    <!--
        In test_full_workflow, the generation of PDF
        seems to be done by OdooBot (__system__) user
        so we add this groups to that user.
    -->
    <record id="base.user_root" model="res.users">
        <field name="groups_id" eval="[
            (4, ref('uom.group_uom')),
        ]" />
    </record>

</odoo>
